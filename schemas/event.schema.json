{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siso:great-library:schema:event:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "occurred_at", "recorded_at", "immutable", "entry_type", "thread", "status", "title", "summary", "intent", "reasoning", "changes", "scope", "coordination", "visibility", "evidence", "next_actions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "event" },
    "id": { "$ref": "common.schema.json#/$defs/eventId" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "immutable": { "const": true },
    "entry_type": { "enum": ["initiative_started", "initiative_updated", "initiative_blocked", "initiative_resumed", "initiative_completed", "decision_recorded", "change_published", "verification_completed", "correction_recorded"] },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/threadId" },
        "name": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["initiative", "release", "decision", "maintenance", "research"] }
      }
    },
    "status": { "enum": ["planned", "active", "blocked", "completed", "cancelled", "informational"] },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 10 },
    "intent": { "type": "string", "minLength": 10 },
    "reasoning": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "summary"],
        "properties": {
          "kind": { "enum": ["commit", "document", "registry_record", "schema", "generator", "test", "deployment", "coordination"] },
          "reference": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 3 }
        }
      }
    },
    "scope": { "$ref": "common.schema.json#/$defs/registryScope" },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "branch", "reserved_paths"],
      "properties": {
        "owner": { "type": "string", "minLength": 2 },
        "branch": { "type": "string", "minLength": 1 },
        "reserved_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "visibility": { "const": "public" },
    "predecessor_event_id": { "$ref": "common.schema.json#/$defs/eventId" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
    "next_actions": { "type": "array", "items": { "type": "string", "minLength": 3 } }
  }
}
