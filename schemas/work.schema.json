{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siso:great-library:schema:work:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "slug", "name", "summary", "work_type", "lifecycle_status", "updated_at", "provenance", "relationships", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "work" },
    "id": { "$ref": "common.schema.json#/$defs/workId" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 10 },
    "work_type": { "enum": ["library", "section", "application", "project", "agent_system", "knowledge_system", "research_question", "tool", "skill", "playbook", "capability_pack", "bundle"] },
    "lifecycle_status": { "enum": ["planned", "experimental", "active", "retired", "unknown"] },
    "updated_at": { "type": "string", "format": "date" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "relationships": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relationship" } },
    "reading": {
      "type": "object", "additionalProperties": false,
      "required": ["subtitle", "why", "highlights", "agent_entry", "agent_commands", "owner", "reference"],
      "properties": {
        "subtitle": { "type": "string", "minLength": 10 },
        "why": { "type": "string", "minLength": 30 },
        "highlights": { "type": "array", "minItems": 3, "maxItems": 7, "items": {
          "type": "object", "additionalProperties": false, "required": ["title", "summary", "url"],
          "properties": { "title": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 10 }, "url": { "type": "string", "format": "uri" } }
        } },
        "agent_entry": { "type": "string", "format": "uri" },
        "agent_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "owner": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "research_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "state", "evidence_mode", "source_work_ids", "source_scopes", "answer_shape", "refresh_policy", "publication_boundary"],
      "properties": {
        "question_id": { "type": "string", "pattern": "^GQ-[0-9]{3}$" },
        "question": { "type": "string", "minLength": 20 },
        "state": { "enum": ["captured", "scoped", "researching", "partial", "answered", "stale", "blocked", "merged", "retired"] },
        "evidence_mode": { "enum": ["corpus", "live_anchored", "hybrid"] },
        "source_work_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/workId" } },
        "source_scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "decision_to_change": { "type": "string", "minLength": 10 },
        "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "falsifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "evidence_gaps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "watch_triggers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "answer_shape": { "type": "string", "minLength": 10 },
        "refresh_policy": { "type": "string", "minLength": 10 },
        "publication_boundary": { "enum": ["public_metadata_only", "public_evidence", "public_answer"] },
        "program": { "$ref": "god-question-program.schema.json" },
        "state_note": { "type": "string", "minLength": 3 },
        "baseline_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "from_cohort", "script", "metrics", "scope"],
          "properties": {
            "rule": { "type": "string", "minLength": 1 },
            "from_cohort": { "type": "string", "minLength": 1 },
            "script": { "type": "string", "minLength": 1 },
            "metrics": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 }
          }
        },
        "watch_trigger_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluated_at"],
          "properties": {
            "evaluated_at": { "type": "string", "format": "date" },
            "1": { "type": "string", "minLength": 3 },
            "2": { "type": "string", "minLength": 3 },
            "3": { "type": "string", "minLength": 3 },
            "4": { "type": "string", "minLength": 3 },
            "5": { "type": "string", "minLength": 3 },
            "note": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
  }
}
