{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siso:great-library:schema:assembly:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "slug", "name", "summary", "version", "created_at", "immutable", "section_work_id", "outcome", "components", "operating_loop", "capability_model", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "assembly" },
    "id": { "$ref": "common.schema.json#/$defs/assemblyId" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 10 },
    "version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "immutable": { "const": true },
    "section_work_id": { "$ref": "common.schema.json#/$defs/workId" },
    "outcome": { "type": "string", "minLength": 10 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "work_id", "required", "role", "responsibilities", "depends_on", "evidence"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "work_id": { "$ref": "common.schema.json#/$defs/workId" },
          "required": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 },
          "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
        }
      }
    },
    "operating_loop": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "component_ids", "action", "output"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "component_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "action": { "type": "string", "minLength": 3 },
          "output": { "type": "string", "minLength": 3 }
        }
      }
    },
    "capability_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "playbook", "placement_rule"],
      "properties": {
        "skill": { "type": "string", "minLength": 10 },
        "playbook": { "type": "string", "minLength": 10 },
        "placement_rule": { "type": "string", "minLength": 10 }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
  }
}
