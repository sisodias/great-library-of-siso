{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siso:great-library:schema:god-question-program:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assumptions", "evidence_connections", "action_learning_links"],
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "scope", "statement", "status", "confidence", "falsifier", "review_date"],
        "properties": {
          "id": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "level": { "enum": ["GA", "DA", "QA", "AA"] },
          "scope": { "type": "string", "minLength": 3 },
          "statement": { "type": "string", "minLength": 10 },
          "status": { "enum": ["active", "challenged", "refuted", "superseded"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "falsifier": { "type": "string", "minLength": 10 },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } },
          "supersedes": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "evidence_connection_ids": { "type": "array", "items": { "type": "string", "pattern": "^EC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } },
          "review_date": { "type": "string", "format": "date" }
        }
      }
    },
    "evidence_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_type", "owning_work_id", "reference", "relevance_hypothesis", "rights_state", "observed_at", "provenance_receipt", "revision_or_digest", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^EC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "source_type": { "enum": ["documentation", "registry_record", "source_review", "release_receipt", "repository", "book", "experiment", "operational_receipt"] },
          "owning_work_id": { "$ref": "common.schema.json#/$defs/workId" },
          "reference": { "type": "string", "minLength": 3 },
          "relevance_hypothesis": { "type": "string", "minLength": 10 },
          "rights_state": { "enum": ["public", "public_metadata_only", "owner_held", "rights_review"] },
          "observed_at": { "type": "string", "format": "date" },
          "provenance_receipt": { "type": "string", "minLength": 3 },
          "revision_or_digest": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 10 },
          "supports_assumption_ids": { "type": "array", "items": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } },
          "challenges_assumption_ids": { "type": "array", "items": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } }
        }
      }
    },
    "action_learning_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "object_type", "authority_state", "owner_role", "reference", "status", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^AL-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "object_type": { "enum": ["epistemic_demand", "action_candidate", "execution_mandate", "observation_receipt", "learning_return"] },
          "authority_state": { "enum": ["demand_only", "proposal_only", "approved_scope", "observation_only", "learning_proposal"] },
          "owner_role": { "enum": ["question_steward", "operating_architecture", "decision_owner", "runtime", "independent_verifier", "evidence_engine"] },
          "reference": { "type": "string", "minLength": 3 },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "predecessor_ids": { "type": "array", "items": { "type": "string", "pattern": "^AL-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } },
          "related_assumption_ids": { "type": "array", "items": { "type": "string", "pattern": "^(GA|DA|QA|AA)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } },
          "status": { "enum": ["proposed", "approved", "rejected", "executed", "verified", "expired", "no_change", "reopen_proposed"] },
          "expires_at": { "type": "string", "format": "date-time" },
          "summary": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
