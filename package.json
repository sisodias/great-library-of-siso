{
  "name": "great-library-of-siso",
  "version": "0.1.0",
  "private": true,
  "description": "The human- and agent-readable registry for The Great Library of SISO.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:immutable": "node scripts/check-immutable-history.mjs",
    "test:promotion": "node tests/promotion-contract.test.mjs",
    "test:intelligence": "node tests/intelligence-contract.test.mjs",
    "test:laptop-estate": "node tests/laptop-estate.test.mjs",
    "test:private-overlay": "node tests/laptop-estate-private-overlay.test.mjs",
    "build:private-overlay": "node scripts/build-private-overlay.mjs",
    "audit:laptop": "node scripts/audit-laptop-estate.mjs",
    "validate": "node scripts/validate.mjs",
    "scan": "node scripts/scan-publication.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "node scripts/verify.mjs",
    "deploy:vercel": "npm run verify && vercel deploy --prod --yes --project great-library-of-siso"
  }
}
