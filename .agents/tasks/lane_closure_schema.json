{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siso:great-library:agents:lane-closure:1",
  "title": "Great Library lane closure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane_id", "result", "task_ids", "owned_paths", "evidence_paths", "next_owner", "next_action", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "lane_id": { "type": "string", "minLength": 1 },
    "result": { "enum": ["PASS", "BLOCKED", "ACTIVE-HOLD"] },
    "task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "owned_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidence_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "next_owner": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
